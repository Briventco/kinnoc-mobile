{
  "expo": {
    "name": "Kinnoc",
    "slug": "kinnoc",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kinnoc",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brivent.kinnoc",
      "associatedDomains": [
        "applinks:web.kinnoc.app",
        "applinks:kinnoc.app"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kinnoc uses your photos so you can share images in posts and community conversations.",
        "NSCameraUsageDescription": "Kinnoc uses the camera so you can take photos to share in posts and community conversations."
      }
    },
    "android": {
      "package": "com.brivent.kinnoc",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "web.kinnoc.app" },
            { "scheme": "https", "host": "kinnoc.app" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kinnoc uses your photos so you can share images in posts and community conversations.",
          "cameraPermission": "Kinnoc uses the camera so you can take photos to share in posts and community conversations.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
