# Copy to .env.local and fill in. Every EXPO_PUBLIC_* value is bundled into the app and is
# readable by users — only public configuration belongs here. Never add database URLs,
# Supabase service-role keys, or other server secrets.

# "mock" uses the in-app sample data (development only). "http" calls the Kinnoc API.
EXPO_PUBLIC_API_MODE=mock
# Base URL of the Kinnoc API, including its prefix. Chat connects to the same host over Socket.IO
# (path <prefix>/socket.io). The deployment below uses the DEVELOPMENT Supabase project:
# sign in only with test accounts. Use https in release builds.
#   EXPO_PUBLIC_API_URL=https://kinnoc-api.onrender.com/api/v1
EXPO_PUBLIC_API_URL=

# Supabase Auth and Storage (public project URL and anon/publishable key) of the project the API
# uses. Leave empty to use the development preview sign-in, which is not real authentication.
# Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Allow sample data / preview sign-in in a release build (internal test builds only).
EXPO_PUBLIC_ALLOW_PREVIEW=false
